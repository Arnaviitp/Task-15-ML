# ==============================================
# OAuth Configuration for Social Media Platforms
# ==============================================
# Copy this file to .env and fill in your credentials

# Base URLs (adjust for production)
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================
# TWITTER / X OAuth 2.0
# ==============================================
# Get your credentials from: https://developer.twitter.com/en/portal/dashboard
# 1. Create a new App or use an existing one
# 2. Set up "OAuth 2.0" in "User authentication settings"
# 3. Set the Callback URL to: http://localhost:8000/oauth/twitter/callback
# 4. Required scopes: tweet.read, users.read, offline.access

TWITTER_CLIENT_ID=your_twitter_client_id_here
TWITTER_CLIENT_SECRET=your_twitter_client_secret_here

# ==============================================
# LINKEDIN OAuth 2.0  
# ==============================================
# Get your credentials from: https://www.linkedin.com/developers/apps
# 1. Create a new App
# 2. Go to "Auth" tab and add the redirect URL: http://localhost:8000/oauth/linkedin/callback
# 3. Request access to: r_liteprofile, r_emailaddress, w_member_social (may require verification)

LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# ==============================================
# INSTAGRAM Basic Display API
# ==============================================
# Get your credentials from: https://developers.facebook.com/apps
# 1. Create a new Facebook App (Type: Consumer)
# 2. Add "Instagram Basic Display" product
# 3. Set OAuth Redirect URL to: http://localhost:8000/oauth/instagram/callback
# 4. Add Instagram Test Users in "Roles" section

INSTAGRAM_CLIENT_ID=your_instagram_app_id_here
INSTAGRAM_CLIENT_SECRET=your_instagram_app_secret_here
